#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
rev=$(sed -n '2p' "$root/.bend-version")
if [ ! -d "$root/.toolchain/bend/.git" ]; then
  mkdir -p "$root/.toolchain"
  git clone https://github.com/bendlang/bend.git "$root/.toolchain/bend"
fi
git -C "$root/.toolchain/bend" checkout --detach "$rev"
"$root/scripts/bend" version

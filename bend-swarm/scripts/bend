#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
expected=$(sed -n '2p' "$root/.bend-version")
actual=$(git -C "$root/.toolchain/bend" rev-parse HEAD 2>/dev/null || true)
if [ "$actual" != "$expected" ]; then
  echo "Bend revision mismatch; run scripts/setup" >&2
  exit 1
fi
export BEND_NO_TELEMETRY=1
export CLANG_MODULE_CACHE_PATH="$root/build/clang-cache"
exec bun "$root/.toolchain/bend/bend2/main.ts" "$@"

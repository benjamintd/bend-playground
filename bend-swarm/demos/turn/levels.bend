def projected_inside(inside: Bool, level: U32, p: M.Plane, x: U32, y: U32) -> Bool:
  match inside:
    case False{}: False{}
    case True{}: U32.is_eq(U32.and(projected_row(level,p,y),U32.shln(1,U32.to_nat(x))),0)
def projected_local(level: U32, p: M.Plane, q: M.Point) -> Bool:
  M.Point{+x,+y,_} = q
  projected_inside((x < 10 : U32) && (y < 10 : U32),level,p,x,y)
def projected_free(level: U32, +p: M.Plane, q: M.Point) -> Bool:
  projected_local(level,p,M.local(p,q))

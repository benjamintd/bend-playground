def same_projection(a: M.Point, b: M.Point) -> Bool:
  M.Point{x,y,_} = a
  M.Point{u,v,_} = b
  U32.is_eq(x,u) && U32.is_eq(y,v)
def at_ring(+n: Nat, +level: U32, +p: M.Plane, +q: M.Point) -> Bool:
  match n:
    case 0n: False{}
    case 1n+k: same_projection(M.local(p,q),M.local(p,ring(level,U32.from_nat(k)))) || at_ring(k,level,p,q)
def turn_allowed(+level: U32, p: M.Plane, q: M.Point) -> Bool:
  U32.is_eq(ring_count(level),0) || at_ring(U32.to_nat(ring_count(level)),level,p,q)

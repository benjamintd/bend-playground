+# Conservative triangle/tile overlap after the axis-aligned bounds test.
+# Each inward edge stores its maximum over a tile as a linear function of
+# tile coordinates. Prepare once per triangle, then use two multiplies per
+# edge/cell. One pixel of padding plus a scale-aware roundoff allowance retains
+# boundary samples for both center sampling and four-sample coverage.
+type Edge is Data:
+  Edge{x: F32, y: F32, bias: F32}
+type Edges is Data:
+  Edges{a: Edge, b: Edge, c: Edge}
+
+def edge(~level: Nat, +ax: F32, +ay: F32, bx: F32, by: F32, +sign: F32) -> Edge:
+  +dx = ((ay - by) * sign : F32)
+  +dy = ((bx - ax) * sign : F32)
+  +size = U32.to_f32(U32.shln(4,level))
+  +span = (F32.abs(dx) + F32.abs(dy) : F32)
+  +error = ((F32.abs((dx * ax : F32)) + F32.abs((dy * ay : F32))
+    + span * U32.to_f32(U32.shln(512,level))) * 0.000001 : F32)
+  Edge{(dx * size : F32),(dy * size : F32),
+    ((F32.max(dx,0.0) + F32.max(dy,0.0)) * size - dx * ax - dy * ay + span + error : F32)}
+
+def edges(~level: Nat,t: Triangle) -> Edges:
+  Triangle{Vertex{+ax,+ay,_,_},Vertex{+bx,+by,_,_},Vertex{+cx,+cy,_,_},_} = t
+  +sign = L.pick((((bx - ax) * (cy - ay) - (by - ay) * (cx - ax) : F32) >= 0.0 : F32),1.0,F32.neg(1.0))
+  Edges{edge(~level,ax,ay,bx,by,sign),edge(~level,bx,by,cx,cy,sign),edge(~level,cx,cy,ax,ay,sign)}
+
+def edge_visible(x: F32, y: F32, e: Edge) -> Bool:
+  Edge{dx,dy,bias} = e
+  ((dx * x + dy * y + bias : F32) >= 0.0 : F32)
+
+def overlaps(+x: U32, +y: U32, e: Edges) -> Bool:
+  Edges{a,b,c} = e
+  +fx = U32.to_f32(x)
+  +fy = U32.to_f32(y)
+  edge_visible(fx,fy,a) && edge_visible(fx,fy,b) && edge_visible(fx,fy,c)
+
